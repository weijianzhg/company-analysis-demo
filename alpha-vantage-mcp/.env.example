# Live is the default. The public demo key may return only part of IBM's data.
ALPHA_VANTAGE_MODE=live
ALPHA_VANTAGE_API_KEY=demo
MCP_HOST=127.0.0.1
MCP_PORT=8000

# For a repeatable offline demonstration, explicitly set:
# ALPHA_VANTAGE_MODE=fixture
# Fixture mode has synthetic IBM data only. It is never an automatic fallback.
