MCP_URL=http://127.0.0.1:8000/mcp
# Local model: start a llama.cpp server on port 8081 with tool calling enabled.
MODEL_PROVIDER=llamacpp
LLAMA_CPP_URL=http://127.0.0.1:8081
MODEL_ID=default

# Later, for Bedrock model inference while both services still run locally:
# MODEL_PROVIDER=bedrock
# MODEL_ID=eu.anthropic.claude-sonnet-4-6
# AWS_PROFILE=your-profile
# AWS_REGION=eu-west-1

# For the deployed MCP endpoint instead of local MCP_URL:
# MCP_RUNTIME_ARN=arn:aws:bedrock-agentcore:eu-west-1:ACCOUNT:runtime/ID
